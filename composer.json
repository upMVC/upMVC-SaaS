{
    "name": "bitshost/upmvc-saas",
    "description": "upMVC-SaaS. Multi-tenant SaaS starter built on the upMVC PHP framework. Modular MVC, JWT auth, tenant isolation, rate limiting, plan gating.",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "authors": [
        {
            "name": "Adrian D",
            "email": "contact@delvirai.net",
            "homepage": "https://upmvc.com",
            "role": "Developer"
        }
    ],
    "license": [
        "MIT"
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php scripts/setup.php"
        ]
    },
    "keywords": [
        "saas", "multi-tenant", "boilerplate", "starter-kit",
        "php", "php8", "mvc", "api-first",
        "jwt", "authentication", "role-based-access-control",
        "platform-admin", "tenant-management", "feature-flags"
    ],
    "homepage": "https://upmvc.com"
}