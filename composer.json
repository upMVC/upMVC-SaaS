{
    "name": "bitshost/upmvc-saas",
    "description": "upMVC-SaaS — thin composed multi-tenant starter: Packagist kernel + saas-pack (+ optional payments). App owns public/, .env, packages.php, and domain modules only.",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "bitshost/upmvc": "^2.5",
        "bitshost/upmvc-saas-pack": "^1.1",
        "phpmailer/phpmailer": "^6.9",
        "stripe/stripe-php": "^21.0"
    },
    "suggest": {
        "bitshost/upmvc-payments-pack": "Optional payments floor (cash/bank/Stripe/PayPal drivers + payment_intents). Prefer over growing ad-hoc Billing in the host."
    },
    "authors": [
        {
            "name": "Adrian D",
            "email": "contact@delvirai.net",
            "homepage": "https://upmvc.com",
            "role": "Developer"
        }
    ],
    "license": [
        "MIT"
    ],
    "autoload": {
        "psr-4": {
            "App\\Modules\\": "src/Modules/",
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php scripts/setup.php"
        ],
        "setup": "php scripts/setup.php"
    },
    "keywords": [
        "saas", "multi-tenant", "boilerplate", "starter-kit",
        "php", "php8", "mvc", "api-first",
        "jwt", "authentication", "role-based-access-control",
        "platform-admin", "tenant-management", "feature-flags",
        "upmvc", "harvest"
    ],
    "homepage": "https://upmvc.com"
}
