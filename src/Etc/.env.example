# upMVC-SaaS — copy to .env (php scripts/setup.php does this and generates secrets)

APP_ENV=development
APP_DEBUG=true

# Built-in server: DOMAIN_NAME=http://localhost:8000 and SITE_PATH=
# Apache/XAMPP subfolder: DOMAIN_NAME=http://localhost and SITE_PATH=/upMVC-SaaS/public
DOMAIN_NAME=http://localhost:8000
SITE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=upmvc_saas
DB_USER=root
DB_PASS=

CACHE_DRIVER=file
CACHE_TTL=3600

SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mail (Harvest MailGateway reads these; SMTP password may be sealed via SecretBox)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.local
MAIL_FROM_NAME="upMVC SaaS"

# REQUIRED — app throws if JWT_SECRET is missing
JWT_SECRET=your-random-secret-minimum-32-characters-change-this
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# REQUIRED — SecretBox / seal keys (Harvest dual-unseal also accepts legacy peppers)
APP_KEY=your_app_key_here
BCRYPT_ROUNDS=12

LOG_LEVEL=debug
LOG_CHANNEL=file
LOG_PATH=src/logs

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_MINUTES=1

ROUTE_ERROR_HANDLING=true
ROUTE_VERBOSE_LOGGING=true
ROUTE_SCREEN_OUTPUT=true
ROUTE_SUBMODULE_DISCOVERY=true

PROTECTED_ROUTES=

# Optional — host demo Billing (Stripe Checkout). Prefer upmvc-payments-pack for new work.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# Optional — after requiring bitshost/upmvc-payments-pack
# PAYMENTS_DRIVER=manual
